# Backend environment example
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_TO_FILES=false

# Database / Cache
DATABASE_URL=mongodb://localhost:27017/convo
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# CORS/Client
CLIENT_URL=http://localhost:5173
PREVIEW_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Uploaded files. "local" keeps them on disk in UPLOAD_DIR (default:
# backend/uploads) and the app serves them under /uploads; "s3" uses the
# bucket below. Left empty: s3 when STORAGE_URL is set, local otherwise.
STORAGE_DRIVER=
UPLOAD_DIR=

# Storage (S3-compatible), only for STORAGE_DRIVER=s3
STORAGE_URL=
STORAGE_PUBLIC_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=

# Arcjet (optional)
ARCJET_KEY=