# Secrets for docker-compose.prod.yaml. On the VPS this file is
# ~/apps/convo/.env (chmod 600); never commit the real one.
#
# Make each secret with:  openssl rand -hex 32
# Passwords must stay hex (letters a-f and digits): they go into a MongoDB
# connection URL, where characters like @ : / would break it.

# Signs session cookies. Changing it signs everyone out.
JWT_SECRET=

# MongoDB. These are set when the database is created on the first start;
# changing them here later doesn't change them in the database.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Email through Resend; the sender's domain must be verified there.
RESEND_API_KEY=
EMAIL_FROM=no-reply@convo.deezby.pl
EMAIL_FROM_NAME=Convo

LOG_LEVEL=info
