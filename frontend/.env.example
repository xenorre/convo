# Frontend environment example (Vite reads VITE_* at build/dev time)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
VITE_NODE_ENV=development
VITE_APP_NAME=ConvoChat
VITE_MAX_MESSAGE_LENGTH=2000

# Optional telemetry destinations. Leave empty unless these endpoints exist.
# Monitoring is loaded after the page loads when metrics or health is configured.
VITE_LOG_ENDPOINT=
VITE_METRICS_ENDPOINT=
VITE_HEALTH_ENDPOINT=
